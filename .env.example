# Copie para .env e troque a senha antes de subir o compose:
#   cp .env.example .env
DB_PASSWORD=escolha_uma_senha_forte

# Rede docker do caprinu_api, por onde o admin do Django chega neste banco.
# Descubra o nome real com: docker network ls | grep traefik
CAPRINU_NETWORK=caprinu_api_traefik_proxy
